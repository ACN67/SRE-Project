+        memory.memory_id = compute_memory_id(memory)
+        memories.append(memory.model_dump(mode='json'))
+    request = QueryRequest(query_id='synthetic-d-q', sample_id='synthetic-d', question='Where does Sam work now?')
+    analysis = QueryAnalysis(query_id=request.query_id, sample_id=request.sample_id,
+                             query_intent='current_state', time_mode='latest_known')
+    return {'request': request.model_dump(mode='json'), 'analysis': analysis.model_dump(mode='json'),
+        'candidates': memories, 'conversation_cutoff': None,
+        'provenance': {'data_fingerprint': fingerprint('synthetic-data'),
+            'query_analysis_version': 'synthetic-analysis-v1', 'git_sha': '0' * 40,
+            'run_kind': 'development', 'retriever_fingerprint': fingerprint('synthetic-index')}}
+
+
+class SyntheticDemoAdapter:
+    """Preset completions for example_input only; no semantic inference."""
+    def generate(self, request):
+        document = example_input()
+        a, b = document['candidates']
+        if request.task == 'state_reasoning':
+            payload = {'schema_version': '2.1', 'query_id': 'synthetic-d-q',
+                'relations': [{'from_memory_id': a['memory_id'], 'to_memory_id': b['memory_id'],
+                    'relation': 'SUPERSEDE', 'scope_attribute': 'job',
+                    'evidence_refs': a['source_refs'] + b['source_refs'],
+                    'reason': 'Synthetic preset replacement; not a semantic inference.'}],
+                'decisions': [
+                    {'memory_id': a['memory_id'], 'action': 'EXCLUDE', 'reason': 'Synthetic preset old state.'},
+                    {'memory_id': b['memory_id'], 'action': 'RETAIN', 'reason': 'Synthetic preset new state.'}],
+                'effective_memory_ids': [b['memory_id']], 'unresolved_conflict_ids': [], 'uncertainty': None}
+            mode = 'json'
+        else:
+            payload = {'status': 'answered', 'answer': 'Synthetic preset: Sam works at B.',
+                       'evidence_refs': b['source_refs'], 'uncertainty': None}
+            mode = 'text'
+        return LLMResponse(output_mode=mode, raw_output=json.dumps(payload), finish_reason='stop')
+
+
+def run_smoke():
+    data = example_input()
+    request = QueryRequest.model_validate(data['request'])
+    analysis = QueryAnalysis.model_validate(data['analysis'])
+    memories = [MemoryRecord.model_validate(m) for m in data['candidates']]
+    runtime = create_runtime(synthetic_adapter=SyntheticDemoAdapter())
+    provenance = DynamicProvenance(**data['provenance'])
+    resolution = StateResolver(runtime, provenance, synthetic_test_mode=True)(request, analysis, memories)
+    answer = DynamicAnswerer(runtime, provenance, synthetic_test_mode=True)(request, analysis, resolution, memories)
+    assert answer.used_memory_ids == [memories[1].memory_id]
+    assert answer.evidence_refs == memories[1].source_refs
+    return {'synthetic_fixture': True, 'not_a_formal_score': True,
+            'resolution': resolution.model_dump(mode='json'), 'answer': answer.model_dump(mode='json')}
+
+
+if __name__ == '__main__':
+    print(json.dumps(run_smoke(), ensure_ascii=False, indent=2))
